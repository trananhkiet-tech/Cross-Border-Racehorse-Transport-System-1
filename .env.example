# =====================================================================
# Biến môi trường mẫu cho toàn dự án. KHÔNG điềng bí mật thật vào file này.
# Sao chép phần cần dùng sang:
#   backend/.env   (đọc bởi Spring Boot khi chạy trong thư mục backend/)
#   frontend/.env  (đọc bởi Vite)
# Xem backend/.env và frontend/.env để biết chi tiết từng biến.
# =====================================================================

# --- Backend ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=irtms;encrypt=true;trustServerCertificate=true
DB_USERNAME=irtms_app
DB_PASSWORD=<dat-mat-khau-sql-server>
JWT_SECRET=<chuoi-ngau-nhien-it-nhat-32-ky-tu>
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api
