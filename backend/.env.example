# =====================================================================
# Cấu hình backend (Spring Boot). Sao chép thành backend/.env (đã .gitignore)
# và chạy ứng dụng TỪ THƯ MỤC backend/ để Spring đọc được file này.
# Biến môi trường của hệ điều hành luôn được ưu tiên hơn file .env.
# =====================================================================

# Profile: dev (seed dữ liệu demo, bật Swagger) | prod (không seed, tắt Swagger, bắt buộc JWT_SECRET)
SPRING_PROFILES_ACTIVE=dev

# --- SQL Server ---
# Tạo database trước bằng database/create-database.sql, sau đó Flyway tự tạo bảng khi backend khởi động.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=irtms;encrypt=true;trustServerCertificate=true
DB_USERNAME=irtms_app
DB_PASSWORD=<dat-mat-khau-sql-server>
DB_MIGRATION_ENABLED=true

# --- JWT ---
# Bắt buộc ở profile prod. Tạo chuỗi ngẫu nhiên >= 32 ký tự, ví dụ:  openssl rand -base64 48
# Ở profile dev nếu để trống, backend dùng khóa tạm thời (token mất hiệu lực khi khởi động lại).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# --- Khác ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
APP_TIME_ZONE=Asia/Ho_Chi_Minh
